  "version": "1.2",
  "_readme": [
    "CROSS-DOCUMENT VERIFICATION ORDER (MANDATORY):",
    "  Step 1: Upload CV first     → extracts claimed employment profile (baseline)",
    "  Step 2: Upload EPFO         → cross-verified against CV employers + dates",
    "  Step 3: Upload Bank Stmt    → only if EPFO returns NEEDS_FALLBACK",
    "",
    "HOW TO USE:",
    "1. Import this file into Thunder Client (VS Code extension).",
    "2. In Thunder Client sidebar → Env → click '+' → name it 'Aegis Local'.",
    "3. Add variable: base_url = http://localhost:8000",
    "4. Run requests in order: SETUP applicants first, then PIPELINE TEST.",
    "5. Copy IDs from responses and paste them into the next request.",
    "",
    "FAKE TEST DATA: Use sample PNGs from backend/sample_docs/"
  ],
  "folders": [
    { "id": "f0", "name": "00 - Health",          "containerId": "" },
    { "id": "f1", "name": "01 - Setup Applicants", "containerId": "" },
    { "id": "f2", "name": "02 - Upload Documents", "containerId": "" },
    { "id": "f3", "name": "03 - Pipeline Results", "containerId": "" },
    { "id": "f4", "name": "04 - Admin Review",     "containerId": "" },
    { "id": "f5", "name": "05 - Dashboard",        "containerId": "" }
  ],
