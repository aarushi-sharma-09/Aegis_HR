# ─── Google Gemini ───────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_URI=postgresql+asyncpg://admin:password@localhost:5432/aegis_bgv
# LangGraph checkpointer uses psycopg3 (sync URI):
POSTGRES_URI_SYNC=postgresql://admin:password@localhost:5432/aegis_bgv

# ─── App ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
UPLOAD_DIR=./uploads
FRONTEND_ORIGIN=http://localhost:5173
